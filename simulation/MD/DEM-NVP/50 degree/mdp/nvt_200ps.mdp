; 323.15 K NVT relaxation. Time is ps; 100000 steps at 0.002 ps = 200 ps.
integrator               = md
dt                       = 0.002
nsteps                   = 100000
constraints              = h-bonds
constraint-algorithm     = lincs
lincs-order              = 4
cutoff-scheme            = Verlet
nstlist                  = 20
rcoulomb                 = 1.0
rvdw                     = 1.0
coulombtype              = PME
pme-order                = 4
fourierspacing           = 0.12
vdwtype                  = Cut-off
DispCorr                 = EnerPres
tcoupl                   = V-rescale
tc-grps                  = System
tau-t                    = 1.0
ref-t                    = 323.15
pcoupl                   = no
gen-vel                  = yes
gen-temp                 = 323.15
gen-seed                 = 13053
nstenergy                = 2500
nstlog                   = 2500
nstxout-compressed       = 10000

