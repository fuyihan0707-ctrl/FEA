; 323.15 K, 1 bar isotropic NPT. Time is ps; 1000000 steps = 2 ns.
integrator               = md
dt                       = 0.002
nsteps                   = 1000000
continuation             = yes
constraints              = h-bonds
constraint-algorithm     = lincs
lincs-order              = 4
cutoff-scheme            = Verlet
nstlist                  = 20
rcoulomb                 = 1.0
rvdw                     = 1.0
coulombtype              = PME
pme-order                = 4
fourierspacing           = 0.12
vdwtype                  = Cut-off
DispCorr                 = EnerPres
tcoupl                   = V-rescale
tc-grps                  = System
tau-t                    = 1.0
ref-t                    = 323.15
pcoupl                   = Parrinello-Rahman
pcoupltype               = isotropic
tau-p                    = 5.0
ref-p                    = 1.0
compressibility          = 4.5e-5
gen-vel                  = no
nstenergy                = 2500
nstlog                   = 2500
nstxout-compressed       = 10000

